<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime exceptions for the Developer ID signed Editora.app (scripts/aot_build.java signs with
  this file when EDITORA_MAC_SIGN_IDENTITY is set). Notarization requires the hardened runtime, and a JVM
  cannot run under it without these three:
    allow-jit                        HotSpot's JIT maps its code cache with MAP_JIT.
    allow-unsigned-executable-memory the JVM writes executable stubs and adapters outside MAP_JIT regions.
    disable-library-validation       JNA and pty4j unpack their native libraries to a temp/cache directory
                                     and dlopen them; those copies are not signed with our team ID.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
