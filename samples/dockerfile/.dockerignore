# A .dockerignore for the Dockerfile beside it. Every dotfile ending in "ignore" uses the same grammar
# as .gitignore; this one is inert here (only `docker build` reads it, and nothing in this repository
# builds from this folder), so it is safe to keep where a real .gitignore would not be.

# Build output
target/
build/
**/*.class

# Dependencies and caches
node_modules/
.gradle/

# Everything under docs/ except the licence
docs/*
!docs/LICENSE.md

# Local files: a character class, a single-character wildcard, and an escaped name
*.log
.env*
notes-[0-9]?.txt
\#scratch#
