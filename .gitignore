# Build output
target/
*.class
dist/
# The rendered user guide a packaged build carries (pom: docs.site.dir)
.docs-site/
.docs-site.*

# Example plugin build artifacts
examples/*/*.jar
examples/*/*.zip
examples/*/.build/
examples/*/.zipstage/
examples/*/.classpath

# Maven
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Logs
*.log

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
*.code-workspace

# Claude Code local dev helper (settings.local.json is covered by global ignore)
.claude/launch.json

# Node (stray installs from npx-based tools like the Mermaid CLI / maid)
/node_modules/
/package-lock.json
/package.json

# OS
.DS_Store
Thumbs.db

# Generated large/perf samples (created by scripts/GenSamples.java)
/samples/perf/

# Build output from RUNNING the build-tool samples (samples/build-tools/* exist to be run, so this WILL
# appear). `target/` above already covers Maven/Cargo; these are the rest. SamplesCorpusTest honors this
# file, so generated output is never mistaken for an undocumented committed sample.
/samples/build-tools/cargo/Cargo.lock
/samples/debug/rust/Cargo.lock
/samples/debug/cpp/build/
/samples/debug/csharp/bin/
/samples/debug/csharp/obj/
# The debug samples ship launch.json / tasks.json to try Debug: Start Configuration… on.
!/samples/debug/cpp/.vscode/
!/samples/debug/csharp/.vscode/
!/samples/debug/ruby/.vscode/
!/samples/debug/rust/.vscode/
/samples/build-tools/gradle/.gradle/
/samples/build-tools/gradle/build/
/samples/build-tools/go/go-demo
/samples/build-tools/npm/node_modules/
# The Clojure CLI caches a project's classpath beside its deps.edn when the debug sample is run.
/samples/debug/clojure/.cpcache/
# clojure-lsp and clj-kondo write their caches beside the deps.edn they analyse.
/samples/debug/clojure/.clj-kondo/
/samples/debug/clojure/.lsp/

# Corpus log samples are intentionally tracked (the global *.log above would drop them)
!/samples/log/*.log

# Files the HTTP Client samples write with >> (samples/http/save-response.http).
samples/http/responses/
# What running the debug, test and build-tool samples writes, and the launch.json files they ship.
!/samples/debug/powershell/.vscode/
/samples/**/__pycache__/
/samples/**/.pytest_cache/
/samples/tests/pytest/.venv/
!/samples/debug/node/.vscode/
/samples/debug/node/node_modules/
/samples/debug/node/package-lock.json
/samples/tests/jest/node_modules/
/samples/tests/jest/package-lock.json
/samples/tests/vitest/node_modules/
/samples/tests/vitest/package-lock.json
/samples/debug/kotlin/.gradle/
/samples/debug/kotlin/.kotlin/
/samples/debug/kotlin/build/
/samples/debug/groovy/spock/.gradle/
/samples/debug/groovy/spock/build/

/samples/debug/scala/.scala-build/
/samples/debug/scala/.bsp/
/samples/debug/scala/.metals/
/samples/build-tools/sbt/.bsp/
/samples/build-tools/sbt/.metals/
/samples/build-tools/sbt/.bloop/
/samples/build-tools/sbt/project/project/
/samples/build-tools/sbt/project/metals.sbt
/samples/build-tools/mill/out/
/samples/build-tools/mill/.bsp/
/samples/build-tools/mill/.metals/
/samples/build-tools/mill/.bloop/
/samples/build-tools/lein/.lein-failures
/samples/build-tools/lein/.lein-repl-history
/samples/build-tools/lein/.nrepl-port
/samples/build-tools/lein/.clj-kondo/
/samples/build-tools/lein/.lsp/
/samples/build-tools/babashka/.clj-kondo/
/samples/build-tools/babashka/.lsp/
!/samples/debug/lua/.vscode/
/samples/debug/dart/.dart_tool/
/samples/debug/dart/pubspec.lock
/samples/debug/elixir/_build/
/samples/debug/elixir/.elixir_ls/
/samples/tests/exunit/_build/
/samples/tests/exunit/.elixir_ls/
/samples/tests/*/build/
/samples/tests/phpunit/vendor/
/samples/tests/phpunit/composer.lock
