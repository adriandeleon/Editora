{
  "name": ".gitignore (Node)",
  "description": "A .gitignore for Node.js and TypeScript: dependencies, build output, logs, env files",
  "fileName": ".gitignore",
  "body": [
    "# Dependencies",
    "node_modules/",
    "",
    "# Build output and caches",
    "dist/",
    "build/",
    "coverage/",
    ".cache/",
    "*.tsbuildinfo",
    "",
    "# Logs",
    "npm-debug.log*",
    "yarn-debug.log*",
    "yarn-error.log*",
    "pnpm-debug.log*",
    "",
    "# Local environment",
    ".env",
    ".env.local",
    ".env.*.local",
    "",
    "# Editors and OS files",
    ".idea/",
    "*.iml",
    ".vscode/",
    ".DS_Store",
    "Thumbs.db"
  ]
}
