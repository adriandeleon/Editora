{
  "name": ".gitignore (Python)",
  "description": "A .gitignore for Python: bytecode, virtual environments, build and tool caches",
  "fileName": ".gitignore",
  "body": [
    "# Bytecode and native extensions",
    "__pycache__/",
    "*.py[cod]",
    "*.so",
    "",
    "# Virtual environments and local settings",
    ".venv/",
    "venv/",
    ".env",
    "",
    "# Packaging",
    "build/",
    "dist/",
    "*.egg-info/",
    ".eggs/",
    "",
    "# Test, type-check and lint caches",
    ".pytest_cache/",
    ".mypy_cache/",
    ".ruff_cache/",
    ".tox/",
    ".coverage",
    "htmlcov/",
    "",
    "# Jupyter",
    ".ipynb_checkpoints/",
    "",
    "# Editors and OS files",
    ".idea/",
    "*.iml",
    ".vscode/",
    ".DS_Store",
    "Thumbs.db"
  ]
}
