{
  "name": "Python Project",
  "description": "A Python package (src layout) with a main module, a test, a pyproject.toml and a README (multi-file)",
  "language": "python",
  "files": [
    {
      "path": "pyproject.toml",
      "body": [
        "[project]",
        "name = \"${packageName:app}\"",
        "version = \"0.1.0\"",
        "description = \"${description:A Python project}\"",
        "requires-python = \">=3.11\"",
        "dependencies = []",
        "",
        "[project.scripts]",
        "${packageName:app} = \"${packageName:app}.main:main\"",
        "",
        "[build-system]",
        "requires = [\"setuptools>=68\"]",
        "build-backend = \"setuptools.build_meta\"",
        "",
        "[tool.pytest.ini_options]",
        "pythonpath = [\"src\"]",
        "testpaths = [\"tests\"]"
      ]
    },
    {
      "path": "src/${packageName:app}/__init__.py",
      "body": ["\"\"\"${description:A Python project}.\"\"\"", "", "__version__ = \"0.1.0\""]
    },
    {
      "path": "src/${packageName:app}/main.py",
      "body": [
        "\"\"\"Entry point for ${packageName:app}.\"\"\"",
        "",
        "",
        "def main() -> None:",
        "    ${cursor}print(\"Hello from ${packageName:app}\")",
        "",
        "",
        "if __name__ == \"__main__\":",
        "    main()"
      ]
    },
    {
      "path": "tests/test_main.py",
      "body": [
        "import unittest",
        "",
        "from ${packageName:app} import __version__",
        "",
        "",
        "class TestVersion(unittest.TestCase):",
        "    def test_version(self) -> None:",
        "        self.assertEqual(__version__, \"0.1.0\")",
        "",
        "",
        "if __name__ == \"__main__\":",
        "    unittest.main()"
      ]
    },
    {
      "path": "README.md",
      "body": [
        "# ${packageName:app}",
        "",
        "${description:A Python project}",
        "",
        "## Set up",
        "",
        "The package lives in `src/`, so install it (editable) into a virtual environment once:",
        "",
        "```bash",
        "python3 -m venv .venv",
        "source .venv/bin/activate      # Windows: .venv\\Scripts\\activate",
        "pip install -e .",
        "```",
        "",
        "## Run",
        "",
        "```bash",
        "python -m ${packageName:app}.main     # or the installed command: ${packageName:app}",
        "```",
        "",
        "## Test",
        "",
        "```bash",
        "python -m unittest discover -s tests",
        "# or, with pytest installed (pip install pytest):",
        "pytest",
        "```",
        "",
        "---",
        "",
        "Created by ${author} on ${date}."
      ]
    },
    {
      "path": ".gitignore",
      "body": ["__pycache__/", "*.py[cod]", ".venv/", "dist/", "build/", "*.egg-info/", ".pytest_cache/"]
    }
  ]
}
