{
  "name": ".gitignore (Java)",
  "description": "A .gitignore for Maven and Gradle projects: build output, jars, logs, IDE files",
  "fileName": ".gitignore",
  "body": [
    "# Build output",
    "target/",
    "build/",
    "out/",
    "*.class",
    "",
    "# Packaged artifacts (the Gradle wrapper jar stays tracked)",
    "*.jar",
    "*.war",
    "*.ear",
    "!gradle/wrapper/gradle-wrapper.jar",
    "",
    "# Gradle",
    ".gradle/",
    "",
    "# Logs and JVM crash files",
    "*.log",
    "hs_err_pid*.log",
    "replay_pid*.log",
    "",
    "# Eclipse",
    ".classpath",
    ".project",
    ".settings/",
    "bin/",
    "",
    "# Editors and OS files",
    ".idea/",
    "*.iml",
    ".vscode/",
    ".DS_Store",
    "Thumbs.db"
  ]
}
