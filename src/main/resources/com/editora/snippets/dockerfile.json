{
  "From": {
    "prefix": "from",
    "body": [
      "FROM ${1:image}:${2:tag}$0"
    ],
    "description": "Base image"
  },
  "From as stage": {
    "prefix": "fromas",
    "body": [
      "FROM ${1:image}:${2:tag} AS ${3:build}$0"
    ],
    "description": "Base image for a named build stage"
  },
  "Run": {
    "prefix": "run",
    "body": [
      "RUN ${0:command}"
    ],
    "description": "Run a command while building"
  },
  "Run multi-line": {
    "prefix": "runm",
    "body": [
      "RUN ${1:command} \\\\",
      "\t&& ${0:command}"
    ],
    "description": "Run several commands in one layer"
  },
  "Apt install": {
    "prefix": "apt",
    "body": [
      "RUN apt-get update \\\\",
      "\t&& apt-get install -y --no-install-recommends ${1:package} \\\\",
      "\t&& rm -rf /var/lib/apt/lists/*$0"
    ],
    "description": "Install Debian/Ubuntu packages in one layer"
  },
  "Apk install": {
    "prefix": "apk",
    "body": [
      "RUN apk add --no-cache ${1:package}$0"
    ],
    "description": "Install Alpine packages"
  },
  "Copy": {
    "prefix": "copy",
    "body": [
      "COPY ${1:source} ${2:destination}$0"
    ],
    "description": "Copy files into the image"
  },
  "Copy from stage": {
    "prefix": "copyfrom",
    "body": [
      "COPY --from=${1:build} ${2:source} ${3:destination}$0"
    ],
    "description": "Copy files from another build stage"
  },
  "Add": {
    "prefix": "add",
    "body": [
      "ADD ${1:source} ${2:destination}$0"
    ],
    "description": "Add files (with archive extraction)"
  },
  "Workdir": {
    "prefix": "workdir",
    "body": [
      "WORKDIR ${1:/app}$0"
    ],
    "description": "Working directory"
  },
  "Env": {
    "prefix": "env",
    "body": [
      "ENV ${1:NAME}=${2:value}$0"
    ],
    "description": "Environment variable"
  },
  "Arg": {
    "prefix": "arg",
    "body": [
      "ARG ${1:NAME}=${2:default}$0"
    ],
    "description": "Build argument"
  },
  "Expose": {
    "prefix": "expose",
    "body": [
      "EXPOSE ${1:8080}$0"
    ],
    "description": "Document a listening port"
  },
  "Volume": {
    "prefix": "volume",
    "body": [
      "VOLUME [\"${1:/data}\"]$0"
    ],
    "description": "Mount point"
  },
  "User": {
    "prefix": "user",
    "body": [
      "USER ${1:app}$0"
    ],
    "description": "User to run as"
  },
  "Label": {
    "prefix": "label",
    "body": [
      "LABEL ${1:org.opencontainers.image.source}=\"${2:value}\"$0"
    ],
    "description": "Image label"
  },
  "Cmd": {
    "prefix": "cmd",
    "body": [
      "CMD [\"${1:executable}\", \"${2:argument}\"]$0"
    ],
    "description": "Default command (exec form)"
  },
  "Entrypoint": {
    "prefix": "entrypoint",
    "body": [
      "ENTRYPOINT [\"${1:executable}\", \"${2:argument}\"]$0"
    ],
    "description": "Entry point (exec form)"
  },
  "Healthcheck": {
    "prefix": "healthcheck",
    "body": [
      "HEALTHCHECK --interval=${1:30s} --timeout=${2:3s} --retries=${3:3} \\\\",
      "\tCMD ${0:curl -f http://localhost/ || exit 1}"
    ],
    "description": "Container health check"
  },
  "Shell": {
    "prefix": "shell",
    "body": [
      "SHELL [\"${1:/bin/bash}\", \"-c\"]$0"
    ],
    "description": "Shell used by RUN"
  },
  "Stopsignal": {
    "prefix": "stopsignal",
    "body": [
      "STOPSIGNAL ${1:SIGTERM}$0"
    ],
    "description": "Signal that stops the container"
  },
  "Onbuild": {
    "prefix": "onbuild",
    "body": [
      "ONBUILD ${0:RUN command}"
    ],
    "description": "Instruction for images built from this one"
  },
  "Non-root user": {
    "prefix": "nonroot",
    "body": [
      "RUN groupadd --system ${1:app} \\\\",
      "\t&& useradd --system --gid ${1:app} --create-home ${1:app}",
      "USER ${1:app}$0"
    ],
    "description": "Create and switch to a non-root user"
  },
  "Multi-stage build": {
    "prefix": "multistage",
    "body": [
      "FROM ${1:image}:${2:tag} AS build",
      "WORKDIR /src",
      "COPY . .",
      "RUN ${3:build command}",
      "",
      "FROM ${4:runtime}:${5:tag}",
      "WORKDIR /app",
      "COPY --from=build ${6:/src/out} .",
      "CMD [\"${7:./app}\"]$0"
    ],
    "description": "Two-stage build skeleton"
  },
  "Node image": {
    "prefix": "node",
    "body": [
      "FROM node:${1:22}-slim",
      "WORKDIR /app",
      "COPY package*.json ./",
      "RUN npm ci --omit=dev",
      "COPY . .",
      "EXPOSE ${2:3000}",
      "CMD [\"node\", \"${3:server.js}\"]$0"
    ],
    "description": "Node.js application image"
  },
  "Python image": {
    "prefix": "python",
    "body": [
      "FROM python:${1:3.13}-slim",
      "WORKDIR /app",
      "COPY requirements.txt .",
      "RUN pip install --no-cache-dir -r requirements.txt",
      "COPY . .",
      "CMD [\"python\", \"${2:main.py}\"]$0"
    ],
    "description": "Python application image"
  },
  "Java image": {
    "prefix": "java",
    "body": [
      "FROM eclipse-temurin:${1:25}-jre",
      "WORKDIR /app",
      "COPY ${2:target/app.jar} app.jar",
      "EXPOSE ${3:8080}",
      "ENTRYPOINT [\"java\", \"-jar\", \"app.jar\"]$0"
    ],
    "description": "Java application image"
  }
}
