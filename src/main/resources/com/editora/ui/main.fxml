<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.editora.ui.MainController">
    <top>
        <VBox fx:id="topBox">
            <children>
                <!-- One visual bar, two containers. The ToolBar holds the customizable icon cluster and
                     overflows into its own chevron when the window is narrow; the tail is pinned beside it,
                     so a narrow window hides an icon (also in the menus and the palette) rather than the
                     project switcher and Settings. A ToolBar overflows from its END, so with everything in
                     one bar the priority was exactly backwards. -->
                <HBox fx:id="toolbarRow" styleClass="toolbar-row" alignment="CENTER_LEFT">
                    <children>
                <ToolBar fx:id="toolBar" HBox.hgrow="ALWAYS">
                    <items>
                        <Button fx:id="newButton" onAction="#onNew"/>
                        <Button fx:id="newFromTemplateButton" onAction="#onNewFromTemplate"/>
                        <Button fx:id="openButton" onAction="#onOpen"/>
                        <Button fx:id="openFolderButton" onAction="#onOpenFolder"/>
                        <Button fx:id="closeTabButton" onAction="#onCloseTab"/>
                        <Button fx:id="saveButton" onAction="#onSave"/>
                        <Button fx:id="saveAsButton" onAction="#onSaveAs"/>
                        <Separator orientation="VERTICAL"/>
                        <MenuButton fx:id="recentButton"/>
                        <Button fx:id="clearRecentButton" onAction="#onClearRecent"/>
                        <Separator orientation="VERTICAL"/>
                        <Button fx:id="undoButton" onAction="#onUndo"/>
                        <Button fx:id="redoButton" onAction="#onRedo"/>
                        <Button fx:id="cutButton" onAction="#onCut"/>
                        <Button fx:id="copyButton" onAction="#onCopy"/>
                        <Button fx:id="pasteButton" onAction="#onPaste"/>
                        <Separator orientation="VERTICAL"/>
                        <Button fx:id="findButton" onAction="#onFind"/>
                        <Button fx:id="findInFilesButton" onAction="#onFindInFiles"/>
                        <Separator orientation="VERTICAL"/>
                        <!-- The run-configuration widgets are declared here only so FXML creates and injects
                             them; their position on the bar comes from ToolbarCatalog's layout, like every
                             other customizable item. -->
                        <ComboBox fx:id="runConfigCombo"/>
                        <Button fx:id="runConfigRunButton" onAction="#onRunSelectedConfig"/>
                        <Button fx:id="runConfigDebugButton" onAction="#onDebugSelectedConfig"/>
                        <Button fx:id="runConfigStopButton" onAction="#onStopRun"/>
                        <Separator orientation="VERTICAL"/>
                        <Button fx:id="splitVerticalButton" onAction="#onSplitVertical"/>
                        <Button fx:id="splitHorizontalButton" onAction="#onSplitHorizontal"/>
                        <Separator orientation="VERTICAL"/>
                        <Button fx:id="paletteButton" onAction="#onPalette"/>
                        <Separator orientation="VERTICAL"/>
                        <Button fx:id="simpleModeButton" onAction="#onToggleSimpleMode"/>
                        <Separator orientation="VERTICAL"/>
                        <Button fx:id="settingsButton" onAction="#onSettings"/>
                    </items>
                </ToolBar>
                        <HBox fx:id="toolbarTail" styleClass="toolbar-tail" alignment="CENTER_LEFT"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>
    <center>
        <BorderPane fx:id="workspace">
            <center>
                <TabPane fx:id="tabPane"/>
            </center>
        </BorderPane>
    </center>
    <bottom>
        <VBox fx:id="bottomBox"/>
    </bottom>
</BorderPane>
