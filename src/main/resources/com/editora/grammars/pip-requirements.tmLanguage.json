{
  "name": "pip-requirements",
  "scopeName": "source.pip-requirements",
  "comment": "pip requirements / constraints files (requirements.txt, requirements.in, constraints.txt). Written for Editora.",
  "patterns": [
    {
      "name": "comment.line.number-sign.pip-requirements",
      "match": "(?:^|(?<=\\s))#.*$"
    },
    {
      "comment": "An option line: -r other.txt, -c constraints.txt, -e ./pkg, --index-url URL, --hash=sha256:...",
      "begin": "(?:^|(?<=\\s))(--?[A-Za-z][A-Za-z-]*)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.option.pip-requirements"
        }
      },
      "end": "(?=\\s#)|$",
      "patterns": [
        {
          "include": "#url"
        },
        {
          "name": "variable.parameter.pip-requirements",
          "match": "[^\\s=#]+"
        }
      ]
    },
    {
      "comment": "A requirement: name[extras] specifiers ; marker",
      "begin": "^\\s*([A-Za-z0-9][A-Za-z0-9._-]*)",
      "beginCaptures": {
        "1": {
          "name": "support.type.package.pip-requirements"
        }
      },
      "end": "(?=\\s#)|$",
      "patterns": [
        {
          "comment": "[extra1,extra2]",
          "match": "\\[([^\\]]*)\\]",
          "captures": {
            "1": {
              "name": "variable.parameter.extras.pip-requirements"
            }
          }
        },
        {
          "match": "(===|==|!=|~=|<=|>=|<|>)\\s*([^,;\\s#]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.comparison.pip-requirements"
            },
            "2": {
              "name": "constant.numeric.version.pip-requirements"
            }
          }
        },
        {
          "comment": "A direct reference: name @ URL",
          "match": "(@)\\s*(\\S+)",
          "captures": {
            "1": {
              "name": "keyword.operator.at.pip-requirements"
            },
            "2": {
              "name": "markup.underline.link.pip-requirements"
            }
          }
        },
        {
          "include": "#marker"
        },
        {
          "include": "#option-inline"
        }
      ]
    },
    {
      "include": "#url"
    }
  ],
  "repository": {
    "url": {
      "name": "markup.underline.link.pip-requirements",
      "match": "\\b[A-Za-z][A-Za-z0-9+.-]*://[^\\s#]+"
    },
    "option-inline": {
      "comment": "A per-requirement option after the specifier: --hash=sha256:...",
      "match": "(--[A-Za-z][A-Za-z-]*)(?:(=)([^\\s#]+))?",
      "captures": {
        "1": {
          "name": "keyword.control.option.pip-requirements"
        },
        "3": {
          "name": "variable.parameter.pip-requirements"
        }
      }
    },
    "marker": {
      "comment": "An environment marker after ';': python_version < \"3.13\" and sys_platform == 'win32'",
      "begin": "(;)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.separator.marker.pip-requirements"
        }
      },
      "end": "(?=\\s#)|$",
      "patterns": [
        {
          "name": "keyword.other.marker.pip-requirements",
          "match": "\\b(?:python_version|python_full_version|os_name|sys_platform|platform_release|platform_system|platform_version|platform_machine|platform_python_implementation|implementation_name|implementation_version|extra)\\b"
        },
        {
          "name": "keyword.operator.logical.pip-requirements",
          "match": "\\b(?:and|or|not|in)\\b"
        },
        {
          "name": "keyword.operator.comparison.pip-requirements",
          "match": "===|==|!=|~=|<=|>=|<|>"
        },
        {
          "name": "constant.language.marker-value.pip-requirements",
          "match": "\"[^\"]*\"|'[^']*'"
        }
      ]
    }
  }
}
